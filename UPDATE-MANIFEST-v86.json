{
  "version": "86.0.0",
  "baseline": "My-Recipe-Box-v86(1).zip",
  "release": "SEO, Routing & Shareable URL Update",
  "siteOrigin": "https://www.roberts-recipe-box.com",
  "routing": {
    "supportingPages": "readable permanent paths",
    "recipes": "/recipes/{existing-recipe-code}/",
    "completeDinners": "/complete-dinners/{existing-complete-dinner-code}/",
    "historyApi": true,
    "githubPagesFallback": "public/404.html"
  },
  "seo": {
    "canonicalUrls": true,
    "uniquePageMetadata": true,
    "openGraph": true,
    "twitterCards": true,
    "recipeStructuredData": "added at runtime where ingredient and serving data are sufficient",
    "robots": "public/robots.txt",
    "sitemap": "generated during npm run build"
  },
  "dataCompatibility": {
    "localStorageKeysRenamed": false,
    "backupRestoreFormatChanged": false
  }
}
